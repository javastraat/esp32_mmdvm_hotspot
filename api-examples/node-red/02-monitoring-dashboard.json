  {
    "id": "parse_modeminfo",
    "type": "function",
    "z": "dashboard_flow_tab",
    "name": "Parse Modem Info",
    "func": "const data = msg.payload;\n\nmsg.modemHardware = data.hardware;\nmsg.modemFirmware = data.firmwareVersion;\nmsg.modemTransceiver = data.transceiver;\nmsg.modemCrystal = data.crystal;\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 810,
    "y": 260,
    "wires": [["ui_modem_hardware", "ui_modem_firmware", "ui_modem_transceiver"]]
  },
