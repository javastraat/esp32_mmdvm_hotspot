  {
    "id": "parse_status",
    "type": "function",
    "z": "dashboard_flow_tab",
    "name": "Parse Status",
    "func": "const data = msg.payload;\n\n// Network status\nmsg.wifiConnected = data.wifi.connected;\nmsg.wifiSSID = data.wifi.ssid || 'N/A';\nmsg.wifiIP = data.wifi.ip || data.wifi.apIP || 'N/A';\n\n// DMR status\nmsg.dmrLoggedIn = data.dmr.loggedIn;\nmsg.dmrServer = data.dmr.serverDisplay;\nmsg.mmdvmReady = data.mmdvm.ready;\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 790,
    "y": 380,
    "wires": [["ui_wifi_status", "ui_dmr_status", "ui_mmdvm_status"]]
  },
