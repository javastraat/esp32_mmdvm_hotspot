    "tab": "dashboard_ui_tab",
    "order": 3,
    "disp": true,
    "width": "6",
    "collapse": false
  },
  {
    "id": "inject_poll",
    "type": "inject",
    "z": "dashboard_flow_tab",
    "name": "Poll every 5 sec",
    "props": [],
    "repeat": "5",
    "crontab": "",
    "once": true,
    "onceDelay": 0.1,
    "topic": "",
    "x": 140,
    "y": 100,
    "wires": [["set_baseurl"]]
  },
  {
    "id": "set_baseurl",
    "type": "change",
    "z": "dashboard_flow_tab",
    "name": "Set Base URL & Auth",
    "rules": [
      {
        "t": "set",
        "p": "url",
        "pt": "msg",
        "to": "http://esp32-mmdvm.local",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "headers",
        "pt": "msg",
        "to": "{\"Authorization\":\"Basic \" & $base64encode(\"admin:pi-star\")}",
        "tot": "jsonata"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 340,
    "y": 100,
    "wires": [["get_sysinfo", "get_modeminfo", "get_status", "get_dmr_activity"]]
  },
  {
    "id": "get_sysinfo",
    "type": "http request",
    "z": "dashboard_flow_tab",
    "name": "GET system-information",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://esp32-mmdvm.local/api/system-information",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "sendsearch": false,
    "x": 580,
    "y": 60,
    "wires": [["parse_sysinfo"]]
  },
  {
    "id": "parse_sysinfo",
    "type": "function",
    "z": "dashboard_flow_tab",
    "name": "Parse System Info",
    "func": "const data = msg.payload;\n\n// Memory usage percentage\nmsg.memoryPercent = data.memory.freeHeapPercent;\n\n// Uptime in human readable format\nconst uptime = data.uptime;\nlet uptimeStr = '';\nif (uptime.days > 0) uptimeStr += uptime.days + 'd ';\nif (uptime.hours > 0) uptimeStr += uptime.hours + 'h ';\nuptimeStr += uptime.minutes + 'm ' + uptime.secondsRemaining + 's';\nmsg.uptimeStr = uptimeStr;\n\n// CPU frequency\nmsg.cpuFreq = data.chip.cpuFreqMHz;\n\n// Firmware version\nmsg.firmwareVersion = data.firmware.version;\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 810,
    "y": 60,
    "wires": [["ui_memory_gauge", "ui_uptime_text", "ui_cpu_text", "ui_firmware_text", "ui_memory_chart"]]
  },
  {
    "id": "ui_memory_gauge",
    "type": "ui_gauge",
    "z": "dashboard_flow_tab",
    "name": "Memory Free %",
    "group": "dashboard_group_system",
    "order": 1,
    "width": "3",
    "height": "3",
    "gtype": "gage",
    "title": "Free Memory",
    "label": "%",
    "format": "{{value}}",
    "min": 0,
    "max": "100",
    "colors": ["#ca3838","#e6e600","#00b500"],
    "seg1": "20",
    "seg2": "50",
    "x": 1050,
    "y": 40,
    "wires": []
  },
  {
    "id": "ui_memory_chart",
