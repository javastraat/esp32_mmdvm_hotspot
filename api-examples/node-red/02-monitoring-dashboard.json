    {
        "id": "94b4df74f54f00aa",
        "type": "function",
        "z": "1e83b0d75e9ef307",
        "name": "Parse DMR Activity",
        "func": "const slots = msg.payload.slots;\n\n// Slot 1\nconst slot1 = slots[0];\nif (slot1.active) {\n    msg.slot1Activity = `🔴 ${slot1.srcCallsign} (${slot1.srcName}) → TG${slot1.dstId} [${slot1.duration}s]`;\n} else {\n    msg.slot1Activity = 'Idle';\n}\n\n// Slot 2\nconst slot2 = slots[1];\nif (slot2.active) {\n    msg.slot2Activity = `🔴 ${slot2.srcCallsign} (${slot2.srcName}) → TG${slot2.dstId} [${slot2.duration}s]`;\n} else {\n    msg.slot2Activity = 'Idle';\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
