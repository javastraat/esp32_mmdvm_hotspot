        "name": "GET system-information",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://{{server}}/api/system-information",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "basic",
        "senderr": false,
        "headers": [],
        "x": 580,
