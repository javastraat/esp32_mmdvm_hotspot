    {
        "id": "8ea39d609ae58c65",
        "type": "function",
        "z": "5561a5168b20bc3e",
        "name": "Parse System Info",
        "func": "const data = msg.payload;\n\n// PSRAM percentage (working memory) - FREE percentage\nmsg.psramPercent = ((data.memory.freePsramKB / (data.memory.psramSizeMB * 1024)) * 100).toFixed(1);\n\n// Heap percentage - FREE percentage\nmsg.heapPercent = data.memory.freeHeapPercent;\n\n// Sketch usage percentage - USED percentage (inverse)\nconst totalSketch = data.flash.sketchSizeKB + data.flash.freeSketchSpaceKB;\nmsg.sketchPercent = ((data.flash.freeSketchSpaceKB / totalSketch) * 100).toFixed(1);\n\n// Uptime in human readable format\nconst uptime = data.uptime;\nlet uptimeStr = '';\nif (uptime.days > 0) uptimeStr += uptime.days + 'd ';\nif (uptime.hours > 0) uptimeStr += uptime.hours + 'h ';\nuptimeStr += uptime.minutes + 'm ' + uptime.secondsRemaining + 's';\nmsg.uptimeStr = uptimeStr;\n\n// Chip info\nmsg.chipModel = data.chip.model;\nmsg.chipRevision = data.chip.revision;\nmsg.chipCores = data.chip.cores;\nmsg.cpuFreq = data.chip.cpuFreqMHz;\n\n// Memory details\nmsg.freeHeapKB = data.memory.freeHeapKB.toFixed(1);\nmsg.heapSizeKB = data.memory.heapSizeKB.toFixed(1);\nmsg.minFreeHeapKB = data.memory.minFreeHeapKB.toFixed(1);\nmsg.psramSizeMB = data.memory.psramSizeMB;\nmsg.freePsramKB = data.memory.freePsramKB.toFixed(1);\n\n// Flash info\nmsg.flashSizeMB = data.flash.sizeMB;\nmsg.flashSpeedMHz = data.flash.speedMHz;\nmsg.sketchSizeKB = data.flash.sketchSizeKB.toFixed(1);\nmsg.freeSketchSpaceKB = data.flash.freeSketchSpaceKB.toFixed(1);\n\n// Firmware version\nmsg.firmwareVersion = data.firmware.version;\nmsg.sdkVersion = data.firmware.sdkVersion;\nmsg.buildDate = data.firmware.buildDate;\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 60,
        "wires": [
