    {
        "id": "c0bba6730d3886bc",
        "type": "function",
        "z": "5561a5168b20bc3e",
        "name": "Parse DMR Activity",
        "func": "const slots = msg.payload.slots;\n\n// Slot 1\nconst slot1 = slots[0];\nif (slot1.active) {\n    const callType = slot1.isGroup ? 'Group' : 'Private';\n    msg.slot1Callsign = `${slot1.srcCallsign} (${slot1.srcName})`;\n    msg.slot1DmrId = slot1.srcId;\n    msg.slot1Location = `${slot1.srcCity}, ${slot1.srcCountry}`;\n    msg.slot1Target = `TG${slot1.dstId} (${callType})`;\n    msg.slot1Type = slot1.frameType;\n    msg.slot1Duration = `${slot1.duration}s`;\n    msg.slot1Idle = !slot1.active; // LED should show when idle (not active)\n} else {\n    msg.slot1Callsign = 'Idle';\n    msg.slot1DmrId = '-';\n    msg.slot1Location = '-';\n    msg.slot1Target = '-';\n    msg.slot1Type = '-';\n    msg.slot1Duration = '-';\n    msg.slot1Idle = !slot1.active; // LED should show when idle (not active)\n}\n\n// Slot 2\nconst slot2 = slots[1];\nif (slot2.active) {\n    const callType = slot2.isGroup ? 'Group' : 'Private';\n    msg.slot2Callsign = `${slot2.srcCallsign} (${slot2.srcName})`;\n    msg.slot2DmrId = slot2.srcId;\n    msg.slot2Location = `${slot2.srcCity}, ${slot2.srcCountry}`;\n    msg.slot2Target = `TG${slot2.dstId} (${callType})`;\n    msg.slot2Type = slot2.frameType;\n    msg.slot2Duration = `${slot2.duration}s`;\n    msg.slot2Idle = !slot2.active; // LED should show when idle (not active)\n} else {\n    msg.slot2Callsign = 'Idle';\n    msg.slot2DmrId = '-';\n    msg.slot2Location = '-';\n    msg.slot2Target = '-';\n    msg.slot2Type = '-';\n    msg.slot2Duration = '-';\n    msg.slot2Idle = !slot2.active; // LED should show when idle (not active)\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
